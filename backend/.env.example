# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/pulseloop

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE=7d

# ML Service
ML_SERVICE_URL=http://localhost:8000

# AI Service (Optional - for LLM explanations)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token-change-this
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_MODE=mock

# Twilio WhatsApp (Sandbox - works immediately without Meta approval)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
REMINDER_MAX_PER_DOSE=2
REMINDER_LEAD_TIME_MINUTES=15
